# VitaWise AI Studio — environment variables.
# On Hostinger set these in hPanel → Node.js app → Environment variables (NOT in a committed .env).
# They must exist at build time; restart the app after any change.
# For local dev copy to .env.local (git-ignored).

# --- Phase 0: deployment skeleton ---
# MySQL host. Must be 127.0.0.1 on Hostinger, not localhost.
DB_HOST=127.0.0.1
# MySQL port (default 3306).
DB_PORT=3306
# MySQL user created in hPanel.
DB_USER=
# MySQL user password.
DB_PASSWORD=
# MySQL database name.
DB_NAME=
# Cloudflare account ID (R2 endpoint host).
R2_ACCOUNT_ID=
# R2 API token access key ID.
R2_ACCESS_KEY_ID=
# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=
# Private R2 bucket for uploads and generated images.
R2_BUCKET=
# Username for Basic Auth on /admin (Phase 0 only).
ADMIN_USER=
# Password for Basic Auth on /admin (long, random).
ADMIN_PASSWORD=
# pino log level: info (default), debug, warn, error.
LOG_LEVEL=info

# --- Phase 1: auth + email ---
# Better Auth signing secret (32+ random bytes).
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. https://studio.example.com.
BETTER_AUTH_URL=
# Google OAuth client ID.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Hostinger SMTP host.
SMTP_HOST=
# Hostinger SMTP port.
SMTP_PORT=
# SMTP mailbox username.
SMTP_USER=
# SMTP mailbox password.
SMTP_PASSWORD=
# From address for transactional email.
SMTP_FROM=

# --- Phase 2: jobs + billing ---
# Shared secret sent as x-cron-secret by the hPanel cron job.
CRON_SECRET=
# Moyasar publishable key (test key until launch).
MOYASAR_PUBLISHABLE_KEY=
# Moyasar secret key.
MOYASAR_SECRET_KEY=
# Secret used to verify Moyasar webhooks.
MOYASAR_WEBHOOK_SECRET=

# --- Phase 3+: AI + research ---
# Anthropic API key (text generation).
ANTHROPIC_API_KEY=
# Claude model ID used for text generation.
ANTHROPIC_MODEL=
# Firecrawl API key (search + scrape).
FIRECRAWL_API_KEY=
# Google Gemini API key (images).
GEMINI_API_KEY=
# Gemini image model ID.
GEMINI_IMAGE_MODEL=

# --- Phase 8: Salla ---
# Salla Partners app client ID.
SALLA_CLIENT_ID=
# Salla Partners app client secret.
SALLA_CLIENT_SECRET=
# Base64 32-byte AES-256-GCM key for tokens at rest.
ENCRYPTION_KEY=
